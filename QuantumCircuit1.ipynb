   "source": [
    "'''\n",
    "'''Convergenza statistica nella misurazione di un qubit in sovrapposizione.\n"

    "Questo script analizza come varia la differenza relativa tra le frequenze
    degli esiti |0> e |1> all'aumentare del numero di campionamenti (shots).\n"
    "I risultati della simulazione vengono poi confrontati con l'andamento teorico
    atteso per una distribuzione binomiale.\n"
'''\n",
    "'''\n",
    "\n",
    "\n",
    "from qiskit import QuantumCircuit\n",
    "from qiskit_aer import AerSimulator\n",
    "from qiskit.visualization import plot_histogram\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from qiskit.visualization import circuit_drawer\n",
    "\n",
    "# Definizione del circuito quantistico\n",
    "# Comando creazione circuito -> QuantumCircuit(numero qbit, numero cbit)\n",
    "qc = QuantumCircuit(1,1)\n",
    "# Porta Hadamard: porta il qubit nello stato di sovrapposizione equiprobabile |+>\n",
    "qc.h(0)\n",
    "# Misura del qubit nella base computazionale (proiezione e salvataggio sul bit classico 0)\n",
    "qc.measure(0,0)\n",
    "\n",
    "\n",
    "# Campionamento sperimentale\n",
    "y = np.array([]) # Numero di shots\n",
    "x = np.array([])# Differenza relativa osservata |N_0 - N_1| / N\n",
    "\n",
    "# Inizializzo l'ambiente di simulazione\n",
    "simulator = AerSimulator()\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "# Ad ogni iterazione, il circuito viene eseguito con 'i' campionamenti (shots)\n",
    "# Ad ogni iterazione è poi memorizzato lo scarto relativo tra le frequenze degli esiti |0> e |1>.\n",
    "for i in range(2, 1001, 10):\n",
    "    # Avvia il circuito per i volte\n",
    "    job = simulator.run(qc, shots = i)\n",
    "    # Estraggo l'oggetto contenente le informazioni grezze sull'esperimento completato\n",
    "    result= job.result()\n",
    "    # Analizzo le misurazioni dell'esperimento e le organizzo in un dizionario Python\n",
    "    counts = result.get_counts()\n",
    "    # Conteggio il numero di 1  e 0\n",
    "    n_0 = counts.get('0', 0)\n",
    "    n_1 = counts.get('1', 0)\n",
    "\n",
    "\n",
    "    # Aggiungo alla lista il modulo della differenza relativa\n",
    "    y = np.append(y, (abs(n_0 - n_1)/i)) \n",
    "    x = np.append(x, i)\n",
    "\n",
    "\n",
    "# Generazione della curva teorica\n",
    "# Dominio continuo per la curva teorica\n",
    "shots_list = np.arange(0.3, 1001, 0.1)\n",
    "# Genero le ordinate y corrispondenti alle ascisse x\n",
    "curva_teorica = np.sqrt(2 / (np.pi * shots_list))\n",
    "\n",
    "# Tracciamento del modello teorico e dei punti simulati\n",
    "plt.plot(shots_list, curva_teorica, color='orange', linewidth=2, linestyle='-', alpha=0.3, label=r'Andamento teorico $\\sqrt{2/(\\pi N)}$')\n",
    "plt.scatter(x, y, color ='red', s=2)\n",
    "\n",
    "# Rappresento il circuito graficamento\n",
    "qc.draw('mpl')\n",
    "\n"
   ]
  },
